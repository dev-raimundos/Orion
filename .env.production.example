# Copie este arquivo para ".env" (na raiz do repo) e preencha com valores reais
# antes de rodar: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# NUNCA commite o arquivo ".env" com valores reais.

DATABASE_CONNECTION_STRING=Server=SEU_SERVIDOR;Database=orion;User Id=SEU_USER;Password=SUA_SENHA;TrustServerCertificate=True
JWT_SIGNING_KEY=GERE_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_BYTES
JWT_ISSUER=Orion
JWT_AUDIENCE=Orion.Clients
JWT_EXPIRATION_MINUTES=60

# Aplica as migrations pendentes de Users e Authentication no startup da app.
# Fica "false" por padrão de propósito — ligue "true" só no deploy em que você
# quer mesmo aplicar migration (ex.: logo depois de subir uma release nova),
# e pode voltar pra "false" nos deploys seguintes até a próxima migration.
RUN_MIGRATIONS=false

DOCKER_REGISTRY=
TAG=latest
