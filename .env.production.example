# Referência das variáveis que a produção precisa. Se for deploy manual (sem
# Dokploy), copie pra ".env" na raiz do repo e rode:
#   docker compose up -d
# (sem "-f docker-compose.prod.yml" — não existe mais esse arquivo; o
# "docker-compose.yml" normal já é o de produção por padrão).
#
# Se for via Dokploy, essas mesmas chaves vão no painel de "Environment
# Variables" da aplicação, não num arquivo ".env" no repo.
#
# NUNCA commite o arquivo ".env" com valores reais.

DATABASE_CONNECTION_STRING=Server=SEU_SERVIDOR;Database=orion;User Id=SEU_USER;Password=SUA_SENHA;TrustServerCertificate=True
JWT_SIGNING_KEY=GERE_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_BYTES

# Usar a URL pública real como Issuer é convenção comum (identifica de forma
# única quem emitiu o token), mas não é obrigatório funcionalmente — só
# precisa bater entre emissão e validação, e ambas usam essa mesma variável.
JWT_ISSUER=https://SEU_DOMINIO_AQUI
JWT_AUDIENCE=https://SEU_DOMINIO_AQUI
JWT_EXPIRATION_MINUTES=60
